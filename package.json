{
  "name": "messenger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "targets": {
    "default": {
      "includeNodeModules": true
    }
  },
  
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && node server.cjs",
    "preview": "vite preview",
    "lint": "eslint --config .eslint.cjs --ext .ts,.tsx,.js,.jsx src/",
    "lint:fix": "eslint --fix --config .eslint.cjs --ext .ts,.tsx,.js,.jsx src/",
    "lint:style": "stylelint \"**/*.pcss\"",
    "lint:style:fix": "stylelint \"**/*.pcss\" --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.2.0",
    "postcss": "^8.4.40",
    "postcss-preset-env": "^9.6.0",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-order": "^6.0.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^4.3.9"
  },
  "dependencies": {
    "eslint-config-airbnb": "^19.0.4",
    "express": "^4.19.2",
    "handlebars": "^4.7.7"
  }
}
