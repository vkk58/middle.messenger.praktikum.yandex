.page-layout {
  display: grid;
  grid-template-columns: 300px 1fr;
  position: fixed;
  inset:0;
}

.leftBox {
  background: var(--background-color);
  box-shadow: 2px 0 5px var(--secondary-color);
  box-sizing: border-box;
  height: 100vh;
  left: 0;
  overflow-y: auto;
  padding: 20px;
  width: 300px;
  z-index: 1000;
}

.profileLink {
  font-size: 18px;
  margin-left: 140px;
}

.messageElements {
  background: var(--background-color);
  padding: 15px;
}

.messageContainer {
  align-items: center;
  display: flex;
  gap: 8px;
  flex-grow: 1;
  overflow-y:auto;    
}

.right-content { 
  display:flex;
  flex-direction:column;
  overflow: hidden;
}

.miniImg {
  border-radius: 50%; 
  height: 50px; 
  object-fit: cover;
  width: 50px;     
}

.contactTextType {
  font-size: 1rem;
  font-weight: bold;
}

.contactTextMessageType {
  font-size: 0.8rem;
  font-weight: bold;
}

.lineBreak {
  border-top: 2px solid  var(--linebreak-color);
}

.round-img_Common {
  border-radius: 50%; 
  height: 75px;  
  object-fit: cover;   
  width: 75px;   
}

figure {
    display: block; 
    margin: 0; 
    padding: 0; 
}

.active{
  background : var(--primary-color)
}
        
.messages-container {
    padding: 15px;
    overflow-y: auto;
    flex-direction: column;
    display: flex;
    flex-grow:1; 
}

.message {
    margin-bottom: 15px;
    max-width: 70%;
    padding: 10px 15px;
    border-radius: 18px;
}

.incoming {
    background-color: #fff;
    border: 1px solid #ddd;
    margin-right: auto;
}

.outgoing {
    background-color: #dcf8c6;
    margin-left: auto;
}